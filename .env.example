# Copie este arquivo para .env e ajuste os valores:  copy .env.example .env
# O .env NUNCA vai para o Git. Os valores abaixo são só exemplos para uso local.

# Conexão da aplicação com o PostgreSQL do docker-compose (driver psycopg 3).
# Usuário, senha e banco são os mesmos definidos no docker-compose.yml.
DATABASE_URL=postgresql+psycopg://lavaajato:lavaajato@localhost:5434/lavaajato

# Origens que podem chamar a API (frontend), separadas por vírgula.
# 5500 é a porta padrão do Live Server do VS Code.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Chave secreta para assinar tokens. Gere uma sua com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria
